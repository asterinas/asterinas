Retry PTRACE_ATTACH only on EPERM, which can race with PR_SET_PTRACER.
Report other errors immediately and terminate the tracee. The metadata
test must also stop its child if attaching fails.

In syscall_restart, the tracer waits for a restart_syscall event before
writing the final pipe byte. If nanosleep fails, the tracee must exit
instead of waiting for that byte. Preserve the test failure and use the
exit syscall permitted by the filter.

diff --git a/tools/testing/selftests/seccomp/seccomp_bpf.c b/tools/testing/selftests/seccomp/seccomp_bpf.c
--- a/tools/testing/selftests/seccomp/seccomp_bpf.c
+++ b/tools/testing/selftests/seccomp/seccomp_bpf.c
@@ -1535,7 +1535,7 @@
 void start_tracer(struct __test_metadata *_metadata, int fd, pid_t tracee,
 	    tracer_func_t tracer_func, void *args, bool ptrace_syscall)
 {
-	int ret = -1;
+	int ret;
 	struct sigaction action = {
 		.sa_handler = tracer_stop,
 	};
@@ -1544,10 +1544,12 @@
 	tracer_running = true;
 	ASSERT_EQ(0, sigaction(SIGUSR1, &action, NULL));
 
-	errno = 0;
-	while (ret == -1 && errno != EINVAL)
+	/* PR_SET_PTRACER in the tracee can race with the first attach. */
+	do {
 		ret = ptrace(PTRACE_ATTACH, tracee, NULL, 0);
+	} while (ret == -1 && errno == EPERM);
 	ASSERT_EQ(0, ret) {
+		TH_LOG("PTRACE_ATTACH failed: %s", strerror(errno));
 		kill(tracee, SIGKILL);
 	}
 	/* Wait for attach stop */
@@ -3093,6 +3095,7 @@
 		EXPECT_EQ(0, nanosleep(&timeout, NULL)) {
 			TH_LOG("Call to nanosleep() failed (errno %d: %s)",
 				errno, strerror(errno));
+			syscall(__NR_exit, KSFT_FAIL);
 		}
 
 		/* Read final sync from parent. */
@@ -3331,7 +3334,10 @@
 	ASSERT_EQ(0, close(pipefd[1]));
 	ASSERT_EQ(1, read(pipefd[0], &buf, 1));
 
-	ASSERT_EQ(0, ptrace(PTRACE_ATTACH, pid));
+	ASSERT_EQ(0, ptrace(PTRACE_ATTACH, pid)) {
+		TH_LOG("PTRACE_ATTACH failed: %s", strerror(errno));
+		kill(pid, SIGKILL);
+	}
 	ASSERT_EQ(pid, waitpid(pid, NULL, 0));
 
 	/* Past here must not use ASSERT or child process is never killed. */
