From 369077c7c16797b24c4cef9c4bfaea4a4b871fbf Mon Sep 17 00:00:00 2001
From: Qingsong Chen <changxian.cqs@antgroup.com>
Date: Mon, 21 Sep 2026 09:07:25 +0000
Subject: [PATCH 1/3] gvisor: provide SDK metadata required by Bazel 8.6

The Nix build uses Bazel 8.6, while this gVisor release was written for
Bazel 8.3.1. Register the rules_go compatibility patch so the vendored
rules_go module can run under the newer module extension API.

The Go version is read from gVisor's go.mod. Without explicit Go 1.26.3
archive metadata, Bazel tries to query go.dev while creating the offline
vendor tree, which is forbidden in the Nix sandbox. Provide the filenames
and checksums required to resolve the SDK without a full MODULE.bazel.lock.

---
 MODULE.bazel | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/MODULE.bazel b/MODULE.bazel
index 6878e7ad2..1e8ccab12 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -29,6 +29,7 @@ archive_override(
     patches = [
         "//tools:rules_go_symbols.patch",
         "//tools:rules_go_sdk.patch",
+        "//tools:rules_go_bazel_8_6.patch",
         "//tools:rules_cgo.patch",
         "//tools:rules_go_export.patch",
     ],
@@ -130,6 +131,12 @@ register_toolchains("//:cc_toolchain_aarch64")
 go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
 go_sdk.from_file(
     go_mod = "//:go.mod",
+    sdks = {
+        "linux_amd64": ["go1.26.3.linux-amd64.tar.gz", "2b2cfc7148493da5e73981bffbf3353af381d5f93e789c82c79aff64962eb556"],
+        "linux_arm64": ["go1.26.3.linux-arm64.tar.gz", "9d89a3ea57d141c2b22d70083f2c8459ba3890f2d9e818e7e933b75614936565"],
+        "linux_loong64": ["go1.26.3.linux-loong64.tar.gz", "05215802b85a33dcfdb933a6c3ab881f4f0405587ee6581d33f34cc5c2ab740c"],
+        "linux_riscv64": ["go1.26.3.linux-riscv64.tar.gz", "3b8fd5112340b72587e42c619f43270f1bc21f63cfdb587e6b72e0336580727c"],
+    },
     patch_strip = 1,
     patches = ["//tools:go_types_memoize.patch"],
 )
