# SPDX-License-Identifier: MPL-2.0

# Filesystem type under test. Setting `overlay` selects upstream overlay mode
# directly: common/config runs _overlay_config_override() whenever FSTYP is
# overlay, so run_xfstests.sh does not need to pass ./check the -overlay flag.
export FSTYP=overlay
# Filesystem the overlay's layers are built on. The upper, lower, work and
# mount directories are created inside a filesystem of this type, mounted from
# TEST_DEV and SCRATCH_DEV. common/config derives OVL_BASE_FSTYP from FSTYP
# only when FSTYP names a real filesystem, so with FSTYP=overlay it has to be
# set here; otherwise xfstests would not load the ext2 support needed to mount
# and fsck the layers.
export OVL_BASE_FSTYP=ext2

export TEST_DEV=${XFSTESTS_TEST_DEV:-/dev/vdd}
export SCRATCH_DEV=${XFSTESTS_SCRATCH_DEV:-/dev/vde}

export TEST_DIR=/opt/xfstests/test
export SCRATCH_MNT=/opt/xfstests/scratch

export MOUNT_OPTIONS=""
export EXT_MOUNT_OPTIONS=""
export OVL_BASE_MOUNT_OPTIONS=""

export FSTYP_HAS_NON_DEFAULT_OPTS=0
export SELINUX_MOUNT_OPTIONS=" "

export MKFS_OPTIONS=""
