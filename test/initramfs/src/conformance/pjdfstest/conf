# pjdfstest configuration file.
#
# <pjdfstest>/tests/misc.sh requires this file to work. Upstream derives `fs`
# from `df -PT`, which is unavailable in the Asterinas initramfs, so the
# filesystem under test is identified from /proc/mounts instead.

_pjdfstest_dir=${CONFORMANCE_TEST_WORKDIR:-.}
_pjdfstest_mount_point=
_pjdfstest_fs=
while read -r _pjdfstest_src _pjdfstest_mp _pjdfstest_type _ || [ -n "$_pjdfstest_mp" ]; do
	if [ "$_pjdfstest_mp" = / ]; then
		case $_pjdfstest_dir in
		/*) : ;;
		*) _pjdfstest_mp=; continue ;;
		esac
	else
		case $_pjdfstest_dir in
		"$_pjdfstest_mp" | "$_pjdfstest_mp"/*) : ;;
		*) _pjdfstest_mp=; continue ;;
		esac
	fi

	if [ ${#_pjdfstest_mp} -ge ${#_pjdfstest_mount_point} ]; then
		_pjdfstest_mount_point=$_pjdfstest_mp
		_pjdfstest_fs=$_pjdfstest_type
	fi

	_pjdfstest_mp=
done < /proc/mounts 2>/dev/null

# misc.sh compares `fs` against uppercase names such as `EXT4` in its
# `case "${os}:${fs}"` branches, so report it the way it expects.
fs=$(printf '%s\n' "$_pjdfstest_fs" | tr '[:lower:]' '[:upper:]')

unset _pjdfstest_dir _pjdfstest_mount_point _pjdfstest_fs _pjdfstest_src _pjdfstest_mp _pjdfstest_type

os=Linux
GREP=grep
