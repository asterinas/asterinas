# SPDX-License-Identifier: MPL-2.0

# Watch imported shell sources as well as flake.nix and flake.lock,
# or direnv can keep serving a cached shell after those sources change.
watch_file rust-toolchain.toml
watch_file distro/nixpkgs.nix
watch_dir tools/dev_env/nix
watch_dir test/initramfs/nix

use flake
