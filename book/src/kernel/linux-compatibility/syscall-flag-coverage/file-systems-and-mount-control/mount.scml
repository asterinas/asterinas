// Create a new mount
// Waits for final cleanup of a previous instance from the same source,
// and fails if that cleanup failed.
mount(
    source, target, filesystemtype,
    mountflags = MS_NODEV | MS_NOEXEC | MS_NOSYMFOLLOW,
    data
);

// Move the existing mount point
mount(
    source, target, filesystemtype,
    mountflags = MS_MOVE,
    data
);

// Create a bind mount
mount(
    source, target, filesystemtype,
    mountflags = MS_BIND | MS_REC,
    data
);

// Changes the propagation type of the mount
mount(
    source, target, filesystemtype,
    mountflags = MS_PRIVATE | MS_SLAVE | MS_SHARED | MS_UNBINDABLE | MS_REC,
    data
);
